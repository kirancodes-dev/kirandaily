# Optional. No secrets are needed by this app.

# Base path the app is served from. Leave unset for Vercel/Netlify/local ("/").
# The GitHub Pages workflow sets this automatically (e.g. /kirandaily/).
# BASE_PATH=/kirandaily/

# Firebase web config for cloud sync. Usually you paste these into
# src/config/firebase.ts instead; values here override that file.
# They are public identifiers, not secrets.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

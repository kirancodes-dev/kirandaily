{
  "name": "kiran-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kiran Planner \u2013 a mobile-first personal productivity app (local-only, PWA).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --only firestore --project demo-kiran-planner \"vitest run --config vitest.rules.config.ts\"",
    "build:emulators": "vite build --mode emulators --outDir dist-emulators",
    "test:sync": "npm run build:emulators && npx -y firebase-tools@15 emulators:exec --only auth,firestore --project demo-kiran-planner \"playwright test --config playwright.sync.config.ts\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
